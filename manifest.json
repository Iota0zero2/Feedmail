{
  "manifest_version": 3,
  "name": "Feed Mail",
  "version": "0.6.0",
  "description": "A mail-client style reading view for your own home timeline.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
